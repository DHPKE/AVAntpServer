[Unit]
Description=AVAntpServer upstream connection check and sync watchdog
After=network.target chrony.service

[Service]
User=_chrony
Group=_chrony
Environment=PYTHONPATH=/opt/avantp
ExecStart=/usr/bin/python3 -m avantp heal
RuntimeDirectory=avantp-heal
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/run/chrony
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
